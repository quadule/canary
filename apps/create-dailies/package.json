{
  "name": "create-dailies",
  "version": "0.4.4",
  "type": "module",
  "description": "Set up Dailies \u2014 recorded browser sessions and narrated demo videos. Run `npm create dailies`.",
  "license": "MIT",
  "keywords": [
    "dailies",
    "create",
    "installer",
    "browser-automation",
    "qa"
  ],
  "homepage": "https://github.com/quadule/dailies#readme",
  "bugs": "https://github.com/quadule/dailies/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quadule/dailies.git",
    "directory": "apps/create-dailies"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "create-dailies": "./dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/cli.tsx",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage .turbo",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "dailies-config": "workspace:*",
    "@inkjs/ui": "^2.0.0",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "esbuild": "^0.27.4",
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
